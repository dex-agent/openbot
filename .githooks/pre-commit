#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR >"$work/staged"
git -c core.quotePath=false diff --name-only >"$work/unstaged"
grep -Fx -f "$work/unstaged" "$work/staged" >"$work/partly-staged" || true
grep -Fxv -f "$work/partly-staged" "$work/staged" >"$work/fully-staged" || true

hash_partly_staged() {
  while IFS= read -r path; do
    printf '%s %s\n' "$(git hash-object -- "$path" 2>/dev/null || echo missing)" "$path"
  done <"$work/partly-staged"
}

hash_partly_staged >"$work/before"
echo "Running staged format and lint checks..."
bun run check:staged
hash_partly_staged >"$work/after"

if [ -s "$work/fully-staged" ]; then
  tr '\n' '\0' <"$work/fully-staged" | xargs -0 git add --
fi

if ! cmp -s "$work/before" "$work/after"; then
  echo "Biome fixed files that also have unstaged changes:" >&2
  diff "$work/before" "$work/after" | sed -n 's/^> [^ ]* /  /p' >&2
  echo "Stage the fixes you want to commit, then commit again." >&2
  exit 1
fi

staged_paths=$(git diff --cached --name-only --diff-filter=ACMRD)

if printf '%s\n' "$staged_paths" | grep -Fxq package.json; then
  echo "Checking the release notes..."
  bun scripts/check-release-notes.ts --staged
fi

if printf '%s\n' "$staged_paths" | grep -Fxq apps/mobile/app.json; then
  echo "Checking the mobile release notes..."
  bun scripts/check-release-notes.ts --staged --mobile
fi

if printf '%s\n' "$staged_paths" | grep -Fxq apps/mobile/CHANGELOG.md; then
  echo "Checking the mobile OTA release notes..."
  bun scripts/check-release-notes.ts --staged --ota
fi

git diff --cached --name-only -z --diff-filter=ACMR -- 'changelog.d/*.md' 'apps/mobile/changelog.d/*.md' \
  ':(exclude)changelog.d/README.md' ':(exclude)apps/mobile/changelog.d/README.md' |
  xargs -0 -r bun scripts/check-release-notes.ts --staged --fragments

code_pattern='\.(ts|tsx|mts|cts|js|mjs|cjs|css|grit)$|(^|/)(tsconfig[^/]*|package|biome)\.json$|^apps/mobile/app\.json$|(^|/)bun\.lock$'
if printf '%s\n' "$staged_paths" | grep -Eq "$code_pattern"; then
  echo "Running UI foundation check..."
  bun run check:ui

  echo "Running type checks..."
  bun scripts/staged-typecheck.ts
else
  echo "Skipping UI and type checks: no staged code, style, or configuration files."
fi

schema_pattern='^src/backend/(openbot-database-schema|openbot-database-schema-parity\.test|migrations/[^/]+)\.ts$|^src/backend/openbot-database-schema-history\.json$'
if printf '%s\n' "$staged_paths" | grep -Eq "$schema_pattern"; then
  echo "Running the database schema parity test..."
  bun run test:desktop -- src/backend/openbot-database-schema-parity.test.ts
fi
# >>> code-review-graph pre-commit hook >>>
# Installed by code-review-graph. Remove this file to disable pre-commit graph checks.
if { command -v uvx >/dev/null 2>&1 || command -v code-review-graph >/dev/null 2>&1; }; then
    crg_hook_cli() {
        if command -v code-review-graph >/dev/null 2>&1; then code-review-graph "$@"
        elif command -v uvx >/dev/null 2>&1; then uvx code-review-graph "$@"
        else return 127
        fi
    }
    crg_hook_git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || crg_hook_git_dir=""
    crg_hook_root=$(git rev-parse --show-toplevel 2>/dev/null) || crg_hook_root=""
    if [ -z "$crg_hook_git_dir" ] || [ -z "$crg_hook_root" ]; then
        echo "code-review-graph: skipping automatic checks; cannot determine the Git worktree." >&2
    elif [ -f "$crg_hook_git_dir/commondir" ] && [ "$CRG_HOOK_WORKTREES" != "1" ]; then
        # Only a linked worktree's git dir carries a commondir file (Git 2.5+),
        # so this needs no rev-parse options newer than --absolute-git-dir.
        echo "code-review-graph: skipping automatic checks in a linked worktree;" \
            "set CRG_HOOK_WORKTREES=1 to keep a graph for this worktree too." >&2
    else
        crg_hook_cli update --quiet --repo "$crg_hook_root" || true
        crg_hook_cli detect-changes --brief --repo "$crg_hook_root" || true
    fi
fi
# <<< code-review-graph pre-commit hook <<<
